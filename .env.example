# ---- LLM -----------------------------------------------------------------------
# Without a working LLM the system runs in rule-based mode (regex extraction) and
# routes every document to human review.
#   gemini : Google Gemini (key: https://aistudio.google.com/apikey)
#   groq   : Groq, free tier (key: https://console.groq.com/keys)
#   openai : any OpenAI-compatible API - set LLM_BASE_URL, e.g.
#            OpenRouter https://openrouter.ai/api/v1, Ollama http://host.docker.internal:11434/v1
LLM_PROVIDER=gemini

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Groq / OpenAI-compatible
LLM_API_KEY=
# defaults: groq -> openai/gpt-oss-120b (text); qwen/qwen3.8-27b reads images (LLM_VISION=true) but has a 1000 output-tokens/min free limit
LLM_MODEL=
LLM_BASE_URL=
# true only if LLM_MODEL accepts images (PDFs are always sent as text)
LLM_VISION=false

# Second provider tried when the first is rate limited / over quota / failing.
# Must be the "other kind": gemini <-> groq/openai (they use different settings above).
LLM_FALLBACK_PROVIDER=
# Max simultaneous requests per provider (0 = unlimited). Default: 1 for groq, 0 otherwise.
LLM_CONCURRENCY=
# Seconds a request may wait out per-minute rate limits before moving to the fallback
LLM_RATE_LIMIT_MAX_WAIT_S=90
LLM_TEMPERATURE=0.0
LLM_MAX_RETRIES=3
# Attach the original PDF/image to the prompt (multimodal) for better layout understanding
LLM_SEND_FILES=true

# ---- OCR ---------------------------------------------------------------------
OCR_ENABLED=true
# e.g. eng+ara+fra (install the matching tesseract language packs)
OCR_LANGUAGES=eng
OCR_DPI=300
# Only if tesseract is not on PATH (the default Windows install location is found automatically)
# TESSERACT_CMD=D:\Tools\Tesseract-OCR\tesseract.exe

# ---- Review thresholds -------------------------------------------------------
# document auto-approved at/above this
CONFIDENCE_THRESHOLD=0.80
# any required field below this => review
FIELD_CONFIDENCE_THRESHOLD=0.60
CLASSIFICATION_THRESHOLD=0.60

# ---- Storage / processing ----------------------------------------------------
DATA_DIR=data
# default: SQLite in DATA_DIR
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/idp
MAX_UPLOAD_MB=25
BATCH_CONCURRENCY=4

# ---- API ---------------------------------------------------------------------
# If set, every /api/v1 request must send header `X-API-Key: <value>` (the UI reads API_KEY too)
API_KEY=
LOG_LEVEL=INFO
