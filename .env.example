# ---- LLM (Google Gemini) -----------------------------------------------------
# Get a key at https://aistudio.google.com/apikey . Without a key the system runs in
# rule-based mode (regex extraction) and routes every document to human review.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
LLM_TEMPERATURE=0.0
LLM_MAX_RETRIES=3
# Attach the original PDF/image to the prompt (multimodal) for better layout understanding
LLM_SEND_FILES=true

# ---- OCR ---------------------------------------------------------------------
OCR_ENABLED=true
# e.g. eng+ara+fra (install the matching tesseract language packs)
OCR_LANGUAGES=eng
OCR_DPI=300
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe   # only if not on PATH

# ---- Review thresholds -------------------------------------------------------
# document auto-approved at/above this
CONFIDENCE_THRESHOLD=0.80
# any required field below this => review
FIELD_CONFIDENCE_THRESHOLD=0.60
CLASSIFICATION_THRESHOLD=0.60

# ---- Storage / processing ----------------------------------------------------
DATA_DIR=data
# default: SQLite in DATA_DIR
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/idp
MAX_UPLOAD_MB=25
BATCH_CONCURRENCY=4

# ---- API ---------------------------------------------------------------------
# If set, every /api/v1 request must send header `X-API-Key: <value>` (the UI reads API_KEY too)
API_KEY=
LOG_LEVEL=INFO
